{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myzel.local/protokoll/app/v1/adapter-an-app.schema.json",
  "title": "Nachrichten vom Adapter an die App, Protokoll Version 3 bis 7",
  "description": "Die App prüft streng und trennt bei Verstoß. Neue Felder kommen nur mit einer neuen Protokollversion.",
  "oneOf": [
    { "$ref": "#/$defs/willkommen" },
    { "$ref": "#/$defs/gekoppelt" },
    { "$ref": "#/$defs/rechte" },
    { "$ref": "#/$defs/werte" },
    { "$ref": "#/$defs/aenderung" },
    { "$ref": "#/$defs/quittung" },
    { "$ref": "#/$defs/hinweis" },
    { "$ref": "#/$defs/fehler" }
  ],
  "$defs": {
    "teilFelder": {
      "description": "Datenpunkt eines Kartenteils mit dem, was die App zum Anzeigen und Bedienen braucht",
      "type": "object",
      "required": ["id", "typ", "recht"],
      "properties": {
        "id": { "$ref": "gemeinsam.schema.json#/$defs/objektId" },
        "typ": { "enum": ["number", "string", "boolean"] },
        "einheit": { "type": "string", "maxLength": 30 },
        "min": {
          "description": "Bei Reglern immer da: vom Datenpunkt oder die Vorgabe des Adapters",
          "type": "number"
        },
        "max": { "type": "number" },
        "schritt": {
          "description": "Bei Reglern vom Datenpunkt oder die Vorgabe des Adapters; fehlt er, ist der Regler stufenlos",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "auswahl": {
          "description": "common.states: Wert als Zeichenkette auf Anzeigetext",
          "type": "object",
          "maxProperties": 200,
          "additionalProperties": { "type": "string", "maxLength": 200 }
        },
        "recht": { "enum": ["lesen", "schreiben"] }
      }
    },
    "teil": { "$ref": "#/$defs/teilFelder", "type": "object", "unevaluatedProperties": false },
    "messwertteil": {
      "description": "Teil eines Messwerts: nur Anzeige, mit Bezeichnung",
      "$ref": "#/$defs/teilFelder",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "recht": { "const": "lesen" }
      },
      "unevaluatedProperties": false
    },
    "lampenteile": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "schalten": { "$ref": "#/$defs/teil", "type": "object", "properties": { "typ": { "const": "boolean" } } },
        "helligkeit": {
          "$ref": "#/$defs/teil",
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "typ": { "const": "number" },
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        },
        "farbe": { "$ref": "#/$defs/teil", "type": "object", "properties": { "typ": { "const": "string" } } },
        "farbtemperatur": {
          "$ref": "#/$defs/teil",
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "typ": { "const": "number" },
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        }
      }
    },
    "schalterteile": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "required": ["schalten"],
      "properties": {
        "schalten": { "$ref": "#/$defs/teil", "type": "object", "properties": { "typ": { "const": "boolean" } } }
      }
    },
    "messwertteile": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "wert1": { "$ref": "#/$defs/messwertteil" },
        "wert2": { "$ref": "#/$defs/messwertteil" },
        "wert3": { "$ref": "#/$defs/messwertteil" },
        "wert4": { "$ref": "#/$defs/messwertteil" }
      }
    },
    "thermostatteile": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "required": ["soll"],
      "properties": {
        "soll": {
          "$ref": "#/$defs/teil",
          "type": "object",
          "required": ["min", "max", "schritt"],
          "properties": {
            "typ": { "const": "number" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "schritt": { "type": "number" }
          }
        },
        "ist": {
          "$ref": "#/$defs/teil",
          "type": "object",
          "properties": {
            "typ": { "const": "number" },
            "recht": { "const": "lesen" }
          }
        }
      }
    },
    "karte": {
      "description": "Fertige Karte aus dem Adapter; nur Teile, deren Datenpunkt vorhanden ist und passt",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "typ", "teile"],
      "properties": {
        "id": { "$ref": "gemeinsam.schema.json#/$defs/kennung" },
        "name": { "type": "string", "maxLength": 200 },
        "typ": { "enum": ["lampe", "schalter", "messwert", "thermostat"] },
        "raum": {
          "description": "ID aus raeume; fehlt bei einer Karte ohne Raum",
          "$ref": "gemeinsam.schema.json#/$defs/objektId"
        },
        "teile": { "type": "object" }
      },
      "oneOf": [
        { "type": "object", "properties": { "typ": { "const": "lampe" }, "teile": { "$ref": "#/$defs/lampenteile" } } },
        {
          "type": "object",
          "properties": {
            "typ": { "const": "schalter" },
            "teile": { "$ref": "#/$defs/schalterteile" }
          }
        },
        {
          "type": "object",
          "properties": {
            "typ": { "const": "messwert" },
            "teile": { "$ref": "#/$defs/messwertteile" }
          }
        },
        {
          "type": "object",
          "properties": {
            "typ": { "const": "thermostat" },
            "teile": { "$ref": "#/$defs/thermostatteile" }
          }
        }
      ]
    },
    "raum": {
      "description": "Raum aus ioBroker, in dem eine sichtbare Karte steht",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "gemeinsam.schema.json#/$defs/objektId" },
        "name": { "type": "string", "maxLength": 200 },
        "etage": {
          "description": "Nur ab Protokollversion 5: ID aus etagen; fehlt bei einem Raum ohne Etage",
          "$ref": "gemeinsam.schema.json#/$defs/kennung"
        }
      }
    },
    "etage": {
      "description": "Etage aus dem Admin des Adapters; name für die Überschrift im Kopf, kurz für die Raumleiste",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kurz"],
      "properties": {
        "id": { "$ref": "gemeinsam.schema.json#/$defs/kennung" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "kurz": { "type": "string", "minLength": 1, "maxLength": 8 }
      }
    },
    "zone": {
      "description": "Ein Kreis um den Mittelpunkt; Breite und Länge in Grad (WGS 84), Radius in Metern",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "breite", "laenge", "radius"],
      "properties": {
        "id": { "$ref": "gemeinsam.schema.json#/$defs/zonenId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "breite": { "type": "number", "minimum": -90, "maximum": 90 },
        "laenge": { "type": "number", "minimum": -180, "maximum": 180 },
        "radius": { "type": "integer", "minimum": 100, "maximum": 10000 }
      }
    },
    "rechteInhalt": {
      "type": "object",
      "required": ["profil", "raeume", "karten", "handydaten"],
      "properties": {
        "profil": { "type": "string", "maxLength": 60 },
        "raeume": {
          "description": "Ab Protokollversion 5 in der Reihenfolge, in der die App sie zeigt: nach Etagen, darin wie im Admin geordnet, Räume ohne Etage zuletzt nach Namen",
          "type": "array",
          "items": { "$ref": "#/$defs/raum" }
        },
        "etagen": {
          "description": "Nur ab Protokollversion 5 und dort immer, auch leer: die Etagen mit sichtbaren Räumen, von oben nach unten wie im Admin",
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/etage" }
        },
        "karten": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/karte" } },
        "handydaten": {
          "description": "Was der Adapter von dieser App annimmt; zonen und standort ab Protokollversion 7 und dort immer",
          "type": "object",
          "additionalProperties": false,
          "required": ["akku", "anruf", "benachrichtigung"],
          "properties": {
            "akku": { "type": "boolean" },
            "anruf": { "type": "boolean" },
            "benachrichtigung": { "type": "boolean" },
            "zonen": { "type": "boolean" },
            "standort": { "type": "boolean" }
          }
        },
        "zonen": {
          "description": "Ab Protokollversion 7 und dort immer: die Zonen, die die App erkennen soll, nach Namen. Leer, wenn Zonen für sie aus sind; dann löscht die App ihre Zonen und fragt keinen Standort mehr dafür",
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/zone" }
        },
        "fern": {
          "description": "Ab Protokollversion 6, nur für Apps mit Fernzugang: Vermittler, Schlüssel der App dort und die Lebenszeichen auf diesem Weg (Ping des Adapters alle pingS Sekunden, tot nach totS ohne Ping). Fehlt es, löscht die App, was sie dazu gespeichert hat",
          "type": "object",
          "additionalProperties": false,
          "required": ["adresse", "schluessel", "pingS", "totS"],
          "properties": {
            "adresse": { "$ref": "gemeinsam.schema.json#/$defs/vermittler" },
            "schluessel": { "$ref": "gemeinsam.schema.json#/$defs/vermittlerschluessel" },
            "pingS": { "type": "integer", "minimum": 15, "maximum": 3600 },
            "totS": { "type": "integer", "minimum": 45, "maximum": 7200 }
          }
        }
      }
    },
    "zustand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["val", "ack", "ts"],
      "properties": {
        "val": { "$ref": "gemeinsam.schema.json#/$defs/wert" },
        "ack": { "type": "boolean" },
        "ts": { "$ref": "gemeinsam.schema.json#/$defs/zeitstempel" }
      }
    },
    "zustaende": {
      "description": "ID auf Zustand; null, wenn der Datenpunkt keinen Wert hat",
      "type": "object",
      "propertyNames": { "$ref": "gemeinsam.schema.json#/$defs/objektId" },
      "additionalProperties": { "oneOf": [{ "$ref": "#/$defs/zustand" }, { "type": "null" }] }
    },
    "willkommen": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/rechteInhalt" }],
      "unevaluatedProperties": false,
      "required": ["t", "v", "adapter", "adressen"],
      "properties": {
        "t": { "const": "willkommen" },
        "v": { "$ref": "gemeinsam.schema.json#/$defs/version" },
        "adapter": { "$ref": "gemeinsam.schema.json#/$defs/adapterId" },
        "adressen": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "gemeinsam.schema.json#/$defs/adresse" }
        }
      }
    },
    "gekoppelt": {
      "description": "Antwort auf koppeln nach Bestätigung im Admin; danach folgt willkommen in derselben Verbindung",
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "app", "zugang"],
      "properties": {
        "t": { "const": "gekoppelt" },
        "app": { "$ref": "gemeinsam.schema.json#/$defs/appId" },
        "zugang": { "$ref": "gemeinsam.schema.json#/$defs/zugang" }
      }
    },
    "rechte": {
      "description": "Neuer Stand, wenn sich Profil, Karten, Räume, Datenpunkte in Karten, Systemsprache oder eingeschaltete Handydaten ändern",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/rechteInhalt" }],
      "unevaluatedProperties": false,
      "required": ["t"],
      "properties": { "t": { "const": "rechte" } }
    },
    "werte": {
      "description": "Antwort auf abo: aktueller Stand der abonnierten IDs, bei großen Antworten in mehreren Teilen; jede ID steht in genau einem Teil",
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "werte"],
      "properties": {
        "t": { "const": "werte" },
        "werte": { "$ref": "#/$defs/zustaende" }
      }
    },
    "aenderung": {
      "description": "Änderungen, vom Adapter bis zu 100 ms gesammelt, bei großen Mengen in mehreren Teilen",
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "werte"],
      "properties": {
        "t": { "const": "aenderung" },
        "werte": { "$ref": "#/$defs/zustaende" }
      }
    },
    "quittung": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "n", "ok"],
      "properties": {
        "t": { "const": "quittung" },
        "n": { "$ref": "gemeinsam.schema.json#/$defs/nummer" },
        "ok": { "type": "boolean" },
        "fehler": { "$ref": "gemeinsam.schema.json#/$defs/fehlercode" }
      }
    },
    "hinweis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "id", "text", "wichtigkeit", "zeit"],
      "properties": {
        "t": { "const": "hinweis" },
        "id": { "$ref": "gemeinsam.schema.json#/$defs/hinweisId" },
        "titel": { "type": "string", "maxLength": 200 },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "wichtigkeit": { "enum": ["normal", "hoch"] },
        "zeit": { "$ref": "gemeinsam.schema.json#/$defs/zeit" }
      }
    },
    "fehler": {
      "description": "Bei zugang, version, abgelehnt und abgelaufen trennt der Adapter danach die Verbindung",
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "code"],
      "properties": {
        "t": { "const": "fehler" },
        "code": { "$ref": "gemeinsam.schema.json#/$defs/fehlercode" },
        "text": { "type": "string", "maxLength": 300 },
        "n": { "$ref": "gemeinsam.schema.json#/$defs/nummer" },
        "unterstuetzt": {
          "description": "Nur bei code version: unterstützte Protokollversionen",
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
