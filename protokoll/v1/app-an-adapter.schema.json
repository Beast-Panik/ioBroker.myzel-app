{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myzel.local/protokoll/app/v1/app-an-adapter.schema.json",
  "title": "Nachrichten von der App an den Adapter, Protokoll Version 3 bis 7",
  "description": "Jede Nachricht ist ein JSON-Objekt in einem WebSocket-Textframe, höchstens 64 KiB. Unbekannte Felder sind Fehler.",
  "oneOf": [
    { "$ref": "#/$defs/hallo" },
    { "$ref": "#/$defs/koppeln" },
    { "$ref": "#/$defs/abo" },
    { "$ref": "#/$defs/setze" },
    { "$ref": "#/$defs/akku" },
    { "$ref": "#/$defs/anruf" },
    { "$ref": "#/$defs/benachrichtigung" },
    { "$ref": "#/$defs/auswahl" },
    { "$ref": "#/$defs/angezeigt" },
    { "$ref": "#/$defs/zone" },
    { "$ref": "#/$defs/zonenstand" },
    { "$ref": "#/$defs/standort" },
    { "$ref": "#/$defs/vorschlag" }
  ],
  "$defs": {
    "hallo": {
      "description": "Erste Nachricht einer gekoppelten App, innerhalb von 10 s nach Verbindungsaufbau",
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "v", "app", "zugang", "geraet"],
      "properties": {
        "t": { "const": "hallo" },
        "v": { "$ref": "gemeinsam.schema.json#/$defs/version" },
        "app": { "$ref": "gemeinsam.schema.json#/$defs/appId" },
        "zugang": { "$ref": "gemeinsam.schema.json#/$defs/zugang" },
        "geraet": { "$ref": "gemeinsam.schema.json#/$defs/geraet" }
      }
    },
    "koppeln": {
      "description": "Erste Nachricht einer noch nicht gekoppelten App, mit dem Einmalgeheimnis aus dem QR-Code",
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "v", "geheimnis", "name", "geraet"],
      "properties": {
        "t": { "const": "koppeln" },
        "v": { "$ref": "gemeinsam.schema.json#/$defs/version" },
        "geheimnis": { "$ref": "gemeinsam.schema.json#/$defs/geheimnis" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "geraet": { "$ref": "gemeinsam.schema.json#/$defs/geraet" }
      }
    },
    "abo": {
      "description": "Ersetzt das bisherige Abo vollständig; leere Liste beendet es",
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "ids"],
      "properties": {
        "t": { "const": "abo" },
        "ids": {
          "type": "array",
          "maxItems": 2000,
          "uniqueItems": true,
          "items": { "type": "string", "$ref": "gemeinsam.schema.json#/$defs/objektId" }
        }
      }
    },
    "setze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "n", "id", "val"],
      "properties": {
        "t": { "const": "setze" },
        "n": { "$ref": "gemeinsam.schema.json#/$defs/nummer" },
        "id": { "$ref": "gemeinsam.schema.json#/$defs/objektId" },
        "val": { "$ref": "gemeinsam.schema.json#/$defs/wert" }
      }
    },
    "akku": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "stand", "laedt", "zeit"],
      "properties": {
        "t": { "const": "akku" },
        "stand": { "type": "integer", "minimum": 0, "maximum": 100 },
        "laedt": { "type": "boolean" },
        "zeit": { "$ref": "gemeinsam.schema.json#/$defs/zeit" }
      }
    },
    "anruf": {
      "description": "Nummer und Name fehlen bei frei, bei unterdrückter Nummer und wenn kein Kontakt passt",
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "status", "zeit"],
      "properties": {
        "t": { "const": "anruf" },
        "status": { "enum": ["frei", "klingelt", "gespraech"] },
        "richtung": { "enum": ["eingehend", "ausgehend"] },
        "nummer": { "type": "string", "maxLength": 40, "pattern": "^[+0-9*#]+$" },
        "name": { "type": "string", "maxLength": 100 },
        "zeit": { "$ref": "gemeinsam.schema.json#/$defs/zeit" }
      }
    },
    "benachrichtigung": {
      "description": "Benachrichtigung einer anderen App auf dem Handy; Titel und Text kürzt der Adapter auf die eingestellte Länge",
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "app", "paket", "zeit"],
      "properties": {
        "t": { "const": "benachrichtigung" },
        "app": { "type": "string", "minLength": 1, "maxLength": 100 },
        "paket": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9_.]+$" },
        "titel": { "type": "string", "maxLength": 4000 },
        "text": { "type": "string", "maxLength": 16000 },
        "zeit": { "$ref": "gemeinsam.schema.json#/$defs/zeit" },
        "nachgeliefert": { "type": "boolean" }
      }
    },
    "auswahl": {
      "description": "Ab Version 4: alle Apps, deren Benachrichtigungen die App weitergibt; ersetzt die bisherige Auswahl. Der Adapter legt je App einen Ordner unter benachrichtigungen an und entfernt die Ordner abgewählter Apps",
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "apps"],
      "properties": {
        "t": { "const": "auswahl" },
        "apps": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["paket", "app"],
            "properties": {
              "paket": { "$ref": "#/$defs/benachrichtigung/properties/paket" },
              "app": { "$ref": "#/$defs/benachrichtigung/properties/app" }
            }
          }
        }
      }
    },
    "angezeigt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "id"],
      "properties": {
        "t": { "const": "angezeigt" },
        "id": { "$ref": "gemeinsam.schema.json#/$defs/hinweisId" }
      }
    },
    "zone": {
      "description": "Ab Version 7: Das Handy hat eine Zone betreten (drin true) oder verlassen",
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "id", "drin", "zeit"],
      "properties": {
        "t": { "const": "zone" },
        "id": { "$ref": "gemeinsam.schema.json#/$defs/zonenId" },
        "drin": { "type": "boolean" },
        "zeit": { "$ref": "gemeinsam.schema.json#/$defs/zeit" }
      }
    },
    "zonenstand": {
      "description": "Ab Version 7, nach jeder Anmeldung und wenn sich aktiv ändert: ob die App Zonen erkennen kann und in welchen Zonen das Handy ist. Ohne aktiv zählt drin nicht, grund sagt dann warum; aus heißt in der App ausgeschaltet",
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "aktiv", "drin", "zeit"],
      "properties": {
        "t": { "const": "zonenstand" },
        "aktiv": { "type": "boolean" },
        "grund": { "enum": ["standort_aus", "berechtigung", "ungefaehr", "hintergrund", "energiesparen", "keine_standorte", "aus"] },
        "drin": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "$ref": "gemeinsam.schema.json#/$defs/zonenId" }
        },
        "zeit": { "$ref": "gemeinsam.schema.json#/$defs/zeit" }
      }
    },
    "standort": {
      "description": "Ab Version 7, nur mit der Datenart Standort: Breite und Länge in Grad (WGS 84), Genauigkeit in Metern",
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "breite", "laenge", "genauigkeit", "zeit"],
      "properties": {
        "t": { "const": "standort" },
        "breite": { "type": "number", "minimum": -90, "maximum": 90 },
        "laenge": { "type": "number", "minimum": -180, "maximum": 180 },
        "genauigkeit": { "type": "number", "minimum": 0, "maximum": 100000 },
        "zeit": { "$ref": "gemeinsam.schema.json#/$defs/zeit" }
      }
    },
    "vorschlag": {
      "description": "Ab Version 7, nur auf ausdrücklichen Tipp und mit der Datenart Zonen: ein Standort als Vorschlag für den Mittelpunkt einer Zone. Der Adapter zeigt ihn nur im Reiter Zonen und schreibt ihn nirgends hin",
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "breite", "laenge", "genauigkeit", "zeit"],
      "properties": {
        "t": { "const": "vorschlag" },
        "breite": { "type": "number", "minimum": -90, "maximum": 90 },
        "laenge": { "type": "number", "minimum": -180, "maximum": 180 },
        "genauigkeit": { "type": "number", "minimum": 0, "maximum": 100000 },
        "zeit": { "$ref": "gemeinsam.schema.json#/$defs/zeit" }
      }
    }
  }
}
