{
  "name": "iobroker.myzel-app",
  "version": "0.9.0-alpha.1",
  "private": true,
  "description": "Verbindet die Myzel-App mit ioBroker",
  "author": {
    "name": "Beast-Panik",
    "email": "55361239+Beast-Panik@users.noreply.github.com"
  },
  "contributors": [],
  "license": "UNLICENSED",
  "keywords": [
    "app",
    "android",
    "myzel"
  ],
  "engines": {
    "node": ">= 20"
  },
  "dependencies": {
    "@iobroker/adapter-core": "3.4.3",
    "@iobroker/dm-utils": "3.2.1",
    "@iobroker/type-detector": "6.2.0",
    "ajv": "8.20.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@tsconfig/node20": "^20.1.10",
    "@types/iobroker": "npm:@iobroker/types@^7.2.5",
    "@types/node": "^20.19.43",
    "@types/ws": "8.18.2",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "protokoll/",
    "io-package.json"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "build-adapter ts",
    "watch": "build-adapter ts --watch",
    "test:ts": "mocha --config test/mocharc.custom.json \"{src,werkzeuge}/**/*.test.ts\"",
    "simulator": "ts-node --transpile-only werkzeuge/app-simulator.ts",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts",
    "check": "tsc --noEmit",
    "lint": "eslint -c eslint.config.mjs .",
    "paket": "npm run build && npm pack"
  },
  "readmeFilename": "README.md"
}
