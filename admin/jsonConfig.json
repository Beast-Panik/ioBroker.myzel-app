{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_reiterApps": {
            "type": "panel",
            "label": "Apps",
            "items": {
                "_neuLaden": {
                    "type": "staticText",
                    "text": "Reload hint",
                    "xs": 12
                },
                "geraete": {
                    "type": "deviceManager",
                    "xs": 12
                }
            }
        },
        "_reiterKarten": {
            "type": "panel",
            "label": "Cards",
            "items": {
                "_kartenAus": {
                    "type": "staticText",
                    "text": "Cards page offline",
                    "hidden": "_alive",
                    "xs": 12
                },
                "_kartenseite": {
                    "type": "iframeSendTo",
                    "command": "kartenseite",
                    "xs": 12,
                    "style": { "height": "calc(100vh - 220px)", "minHeight": "420px" }
                }
            }
        },
        "_reiterRaeume": {
            "type": "panel",
            "label": "Rooms",
            "items": {
                "_raeumeAus": {
                    "type": "staticText",
                    "text": "Rooms page offline",
                    "hidden": "_alive",
                    "xs": 12
                },
                "_raumseite": {
                    "type": "iframeSendTo",
                    "command": "raumseite",
                    "xs": 12,
                    "style": { "height": "calc(100vh - 220px)", "minHeight": "420px" }
                }
            }
        },
        "_reiterProfile": {
            "type": "panel",
            "label": "Profiles",
            "items": {
                "_profileAus": {
                    "type": "staticText",
                    "text": "Profiles page offline",
                    "hidden": "_alive",
                    "xs": 12
                },
                "_profilseite": {
                    "type": "iframeSendTo",
                    "command": "profilseite",
                    "xs": 12,
                    "style": { "height": "calc(100vh - 220px)", "minHeight": "420px" }
                }
            }
        },
        "_reiterFern": {
            "type": "panel",
            "label": "Remote access",
            "items": {
                "_fernAus": {
                    "type": "staticText",
                    "text": "Remote access page offline",
                    "hidden": "_alive",
                    "xs": 12
                },
                "_fernseite": {
                    "type": "iframeSendTo",
                    "command": "fernseite",
                    "xs": 12,
                    "style": { "height": "calc(100vh - 220px)", "minHeight": "420px" }
                }
            }
        },
        "_reiterZonen": {
            "type": "panel",
            "label": "Zones",
            "items": {
                "_zonenAus": {
                    "type": "staticText",
                    "text": "Zones page offline",
                    "hidden": "_alive",
                    "xs": 12
                },
                "_zonenseite": {
                    "type": "iframeSendTo",
                    "command": "zonenseite",
                    "xs": 12,
                    "style": { "height": "calc(100vh - 220px)", "minHeight": "420px" }
                }
            }
        },
        "_reiterEinstellungen": {
            "type": "panel",
            "label": "Settings",
            "items": {
                "_kopfVerbindung": {
                    "type": "header",
                    "text": "Connection in home network",
                    "size": 3
                },
                "port": {
                    "type": "port",
                    "label": "Port for apps",
                    "min": 1024,
                    "max": 65535,
                    "xs": 12,
                    "sm": 6,
                    "md": 3
                },
                "adressen": {
                    "type": "chips",
                    "label": "Addresses for apps",
                    "help": "Addresses help",
                    "xs": 12,
                    "md": 9
                },
                "_kopfFristen": {
                    "type": "header",
                    "text": "Time limits",
                    "size": 3,
                    "newLine": true
                },
                "nachlaufMin": {
                    "type": "number",
                    "label": "Presence grace period",
                    "unit": "min",
                    "min": 1,
                    "max": 120,
                    "xs": 12,
                    "sm": 4
                },
                "hinweisFristMin": {
                    "type": "number",
                    "label": "Expiry of hints",
                    "unit": "min",
                    "min": 1,
                    "max": 1440,
                    "xs": 12,
                    "sm": 4
                },
                "textLaenge": {
                    "type": "number",
                    "label": "Length of notification texts",
                    "unit": "characters",
                    "min": 100,
                    "max": 4000,
                    "xs": 12,
                    "sm": 4
                }
            }
        }
    }
}
